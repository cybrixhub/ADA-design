# Copy to .env.local and fill in real values. Never commit .env.local.
# Variable NAMES only — do not put real keys, passwords, or tokens in this file.

# ── Enquiry email (contact form) ──────────────────────────────────────────────

# Resend API key. Required for /api/contact to send anything.
RESEND_API_KEY=

# Enquiry recipients, comma-separated. Optional.
# Defaults to ada.designassociates@gmail.com if unset.
CONTACT_EMAILS=

# Sender shown in the From header. Optional.
# Defaults to "ADA Design <onboarding@resend.dev>", which is Resend's shared
# TESTING sender and only delivers to the Resend account owner's own address.
# For production, verify a domain in Resend and set this to an address on it,
# e.g. CONTACT_FROM="ADA Design <enquiries@your-verified-domain>"
CONTACT_FROM=

# ── Admin panel ───────────────────────────────────────────────────────────────

# Upstash Redis (project + settings storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin auth. ADMIN_JWT_SECRET must be at least 32 characters in production.
ADMIN_JWT_SECRET=
ADMIN_DEFAULT_USER=
ADMIN_DEFAULT_PASSWORD=
